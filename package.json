{
  "name": "coordexp-cc-runtime",
  "version": "0.1.0",
  "description": "Checkout-owned Claude Code headless runtime for Codex",
  "private": true,
  "type": "module",
  "author": {
    "name": "CoordExp"
  },
  "bin": {
    "cc-runtime": "plugin/bootstrap/cc-runtime.mjs"
  },
  "license": "Apache-2.0",
  "files": [
    "plugin",
    "config",
    "LICENSE",
    "NOTICE",
    "README.md",
    "package.json",
    "runtime"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "lint": "eslint runtime tests/runtime",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test tests/runtime/*.test.mjs",
    "test:integration": "node --test tests/runtime-integration/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:integration"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.8.0",
    "globals": "^17.5.0",
    "typescript": "^7.0.2"
  }
}
