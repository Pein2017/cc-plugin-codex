{
  "name": "cc-for-pein-runtime",
  "version": "0.9.0",
  "description": "Checkout-owned durable Claude Agent runtime for Codex",
  "private": true,
  "type": "module",
  "author": {
    "name": "Pein",
    "email": "852128461@qq.com"
  },
  "bin": {
    "cc-for-pein-runtime": "plugins/cc-for-pein/bootstrap/cc-runtime.mjs"
  },
  "license": "Apache-2.0",
  "files": [
    "plugins/cc-for-pein",
    "config",
    "LICENSE",
    "NOTICE",
    "README.md",
    "package.json",
    "runtime"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "install:local": "node scripts/local-plugin-install.mjs --initial",
    "refresh:local": "node scripts/local-plugin-install.mjs --refresh-only",
    "release:local": "node scripts/update-plugin-cachebuster.mjs && node scripts/local-plugin-install.mjs --refresh-only",
    "smoke:release": "node scripts/release-smoke.mjs",
    "lint": "eslint runtime scripts tests/runtime",
    "typecheck": "tsc -p tsconfig.json",
    "test": "CC_RUNTIME_CHECKOUT= CC_RUNTIME_SOURCE_ROOT= CC_RUNTIME_ENV_FILE=$PWD/config/runtime.env node --test tests/runtime/*.test.mjs",
    "test:integration": "CC_RUNTIME_CHECKOUT= CC_RUNTIME_SOURCE_ROOT= CC_RUNTIME_ENV_FILE=$PWD/config/runtime.env node --test tests/runtime-integration/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:integration"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.2.0",
    "globals": "^17.5.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  }
}
