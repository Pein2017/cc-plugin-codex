# Local Claude Code envelope shared by the CC runtime and direct Terminal use.
CLAUDE_CONFIG_DIR=/data/CoordExp/.claude
CONDA_EXE=/root/miniconda3/bin/conda
# The installed bootstrap requires CC_RUNTIME_CHECKOUT in the selected
# project/user .codex/.env. Keep this packaged fallback path-neutral so the
# repository remains movable across worktrees and platforms.
CC_CLAUDE_BIN=/root/.nvm/versions/node/v22.22.0/bin/claude
http_proxy=http://127.0.0.1:9090
https_proxy=http://127.0.0.1:9090
all_proxy=http://127.0.0.1:9090
HTTP_PROXY=http://127.0.0.1:9090
HTTPS_PROXY=http://127.0.0.1:9090
ALL_PROXY=http://127.0.0.1:9090
no_proxy=127.0.0.1,localhost
NO_PROXY=127.0.0.1,localhost
